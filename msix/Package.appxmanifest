<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package for Porter. scripts/build-msix.ps1 stamps the
  version from tauri.conf.json and packs this with the release exe.
  Identity, Publisher and PublisherDisplayName come from Partner Center
  (Product identity) and must match it exactly, or the Store rejects the upload.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 desktop4 rescap">

  <Identity
    Name="TriptoAfsin.PorterApp"
    Publisher="CN=83EC5113-24EF-4718-9965-289BB530FA30"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Porter App</DisplayName>
    <PublisherDisplayName>TriptoAfsin</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Porter"
      Executable="Porter.exe"
      EntryPoint="Windows.FullTrustApplication"
      desktop4:SupportsMultipleInstances="true">
      <!-- SupportsMultipleInstances is required by the console alias below.
           It changes nothing for a full-trust Win32 app. -->
      <uap:VisualElements
        DisplayName="Porter App"
        Description="See which process holds each port and free it in one click."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Porter" />
      </uap:VisualElements>
      <Extensions>
        <!-- porter, the terminal version: the alias makes `porter` work in any
             terminal. It hangs off this Application with its own Executable (as
             Windows Terminal does for wt.exe) because a second Application with
             AppListEntry="none" is a "headless app", which the Store rejects
             without a waiver. It lives in cli\ because porter.exe and Porter.exe
             can't share a folder. -->
        <uap5:Extension Category="windows.appExecutionAlias"
          Executable="cli\porter.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="porter.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
